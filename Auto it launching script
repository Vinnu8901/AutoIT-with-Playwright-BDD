; ==========================================
; CCD INTELLIGENT AUTOMATION (TASKBAR LAUNCH)
; ==========================================

Opt("WinTitleMatchMode", 2)
Opt("SendKeyDelay", 50)

; 🔧 CHANGE THIS → based on your taskbar position
Global $CCD_SHORTCUT = "#3"   ; Win+3 (change if needed)

; =========================
; MAIN FLOW
; =========================
LaunchCCDFromTaskbar()
HandleStartupPopups()
LoginCCD()
OpenAccountMaintenance()
CustomerVerification()
SelectCustomer()
LaunchFraudClosure()
HandleLostStolenWorkflow()

MsgBox(0, "SUCCESS", "Fraud Closure Completed Successfully 🚀")

; =========================
; FUNCTIONS
; =========================

; -------------------------
; LAUNCH CCD FROM TASKBAR
; -------------------------
Func LaunchCCDFromTaskbar()
    Send($CCD_SHORTCUT)
    Sleep(6000)
EndFunc

; -------------------------
; HANDLE STARTUP POPUPS
; -------------------------
Func HandleStartupPopups()

    Local $timeout = 0

    While $timeout < 20

        ; CCP Alert
        If WinExists("CCP Alert") Then
            WinActivate("CCP Alert")
            Sleep(1000)
            Send("{ENTER}")
            Sleep(2000)
        EndIf

        ; Version Popup (DO NOT RESTART)
        If WinExists("Invalid Desktop Version") Then
            WinActivate("Invalid Desktop Version")
            Sleep(1500)
            Send("{ENTER}")
            Sleep(3000)
        EndIf

        ; Wait until login appears
        If WinExists("Logon") Then
            ExitLoop
        EndIf

        Sleep(1000)
        $timeout += 1

    WEnd

EndFunc

; -------------------------
; LOGIN
; -------------------------
Func LoginCCD()

    WinWait("Logon", "", 20)
    WinActivate("Logon")

    Sleep(2000)

    ; Move to Channel dropdown
    Send("{TAB}{TAB}")
    Sleep(1000)

    ; Select Offline - No Phone
    Send("offline")
    Sleep(1000)
    Send("{ENTER}")

    Sleep(1000)

    ; Click OK
    Send("{ENTER}")

    WinWait("Contact Center Desktop", "", 30)
    Sleep(5000)

EndFunc

; -------------------------
; OPEN ACCOUNT MAINTENANCE
; -------------------------
Func OpenAccountMaintenance()

    WinActivate("Contact Center Desktop")
    Sleep(3000)

    ; Click spanner icon (adjust if needed)
    MouseClick("left", 120, 150, 1)

    Sleep(3000)

EndFunc

; -------------------------
; CUSTOMER VERIFICATION
; -------------------------
Func CustomerVerification()

    WinWait("Customer Identification", "", 20)
    WinActivate("Customer Identification")

    Sleep(1000)

    Send("5194520001889254") ; Account
    Send("{TAB}")
    Send("6027")             ; SSN
    Send("{TAB}")
    Send("04/19/1990")       ; DOB

    Sleep(1000)

    ; Click Verify
    Send("{TAB}{TAB}{TAB}")
    Send("{ENTER}")

EndFunc

; -------------------------
; SELECT CUSTOMER
; -------------------------
Func SelectCustomer()

    WinWait("Customer Search Results", "", 20)
    WinActivate("Customer Search Results")

    Sleep(2000)

    Send("{TAB}{TAB}")
    Send("{ENTER}")

    Sleep(5000)

EndFunc

; -------------------------
; LAUNCH FRAUD CLOSURE
; -------------------------
Func LaunchFraudClosure()

    WinActivate("Contact Center Desktop")
    Sleep(3000)

    ; Focus left panel
    Send("{TAB}{TAB}{TAB}")
    Sleep(1000)

    Send("complete a fraud closure")
    Sleep(1000)
    Send("{ENTER}")

EndFunc

; -------------------------
; LOST/STOLEN WORKFLOW
; -------------------------
Func HandleLostStolenWorkflow()

    ; First popup
    WinWait("AA Deconversion", "", 20)
    WinActivate("AA Deconversion")

    Sleep(1000)

    ; Select first option
    Send("{TAB}")
    Send("{SPACE}")

    ; Next
    Send("{TAB}{TAB}")
    Send("{ENTER}")

    ; ---------------------
    ; LOST/STOLEN SCREEN
    ; ---------------------
    WinWait("Lost/Stolen", "", 20)
    WinActivate("Lost/Stolen")

    Sleep(2000)

    ; Primary user
    Send("{TAB}")
    Send("{SPACE}")

    ; Temp hold → No
    Send("{TAB}")
    Send("No")

    ; PIN lost → No
    Send("{TAB}")
    Send("No")

    ; Missing checks → No
    Send("{TAB}")
    Send("No")

    ; Auto selection → No
    Send("{TAB}")
    Send("{SPACE}")

    Sleep(1000)

    ; Select transactions
    Send("{TAB}{TAB}{TAB}{TAB}")
    Sleep(1000)
    Send("+{DOWN 10}")

    Sleep(1000)

    ; Continue
    Send("{TAB}{TAB}")
    Send("{ENTER}")

    Sleep(2000)

    ; Confirm popup
    If WinExists("Confirm Needed") Then
        WinActivate("Confirm Needed")
        Sleep(1000)
        Send("{ENTER}")
    EndIf

EndFunc
