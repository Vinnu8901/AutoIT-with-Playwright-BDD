; =========================
; FUNCTIONS
; =========================

Func LaunchCCD()
    Run($ccdPath)
    Sleep(4000)
EndFunc

; -------------------------
; HANDLE POPUPS (GENERIC)
; -------------------------
Func HandlePopups()

    For $i = 1 To 5

        ; CCP Alert
        If WinExists("CCP Alert") Then
            WinActivate("CCP Alert")
            Sleep(1000)
            Send("{ENTER}")
        EndIf

        ; Version Error
        If WinExists("Invalid Desktop Version") Then
            WinActivate("Invalid Desktop Version")
            Sleep(1000)
            Send("{ENTER}")

            Sleep(2000)
            ProcessClose("ContactCenterDesktop.exe")
            Sleep(3000)

            Run($ccdPath)
            Sleep(4000)
        EndIf

        Sleep(2000)
    Next

EndFunc

; -------------------------
; LOGIN
; -------------------------
Func LoginCCD()

    WinWait("Logon", "", 20)
    WinActivate("Logon")

    Sleep(2000)

    ; Navigate to dropdown
    Send("{TAB}{TAB}")
    Sleep(1000)

    ; Select Offline - No Phone
    Send("offline")
    Sleep(1000)
    Send("{ENTER}")

    Sleep(1000)

    ; Click OK
    Send("{ENTER}")

    ; Wait for main screen
    WinWait("Contact Center Desktop", "", 30)
    Sleep(5000)

EndFunc

