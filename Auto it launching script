; =========================================
; CCD AUTOMATION SCRIPT (FIXED VERSION)
; =========================================

; Wait for CCP Alert popup
WinWaitActive("CCP Alert", "", 20)
ControlClick("CCP Alert", "", "Button1")

; Wait for Logon window
WinWaitActive("Logon", "", 20)

; Give small delay
Sleep(1000)

; Click Extension field manually (adjust coordinates if needed)
MouseClick("left", 950, 520, 1)
Sleep(500)

; Enter Extension
Send("1234")

; Press TAB to go to dropdown
Send("{TAB}")
Sleep(500)

; Open dropdown
Send("{DOWN}")
Sleep(500)

; Select "Offline - No Phone"
Send("{DOWN}{DOWN}")  ; adjust if position changes
Sleep(500)

; Press ENTER
Send("{ENTER}")

; Click OK button (adjust if needed)
MouseClick("left", 1050, 650, 1)

; Wait for CCD main window
WinWaitActive("Contact Center Desktop")

Sleep(5000)

MsgBox(0, "Success", "CCD Login Completed")




